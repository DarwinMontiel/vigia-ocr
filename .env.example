# Copia este archivo a .env y ajusta. Todas las variables usan el prefijo VIGIA_.

VIGIA_PORTAL_URL=http://127.0.0.1:8000

# SQLite para desarrollo; SQL Server en producción:
# VIGIA_BASE_DATOS_URL=mssql+pyodbc://vigia:CAMBIAR@localhost:1433/vigia?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
VIGIA_BASE_DATOS_URL=sqlite:///vigia.db

# Motores en orden de ejecución (del más rápido al más lento). Los no instalados se omiten.
VIGIA_MOTORES=ddddocr,tesseract,easyocr
VIGIA_VARIANTES=otsu_x2_apertura,otsu_x2,canal_minimo,mediana,original
VIGIA_MIN_ACUERDO=2
VIGIA_MAX_IMAGENES=3

VIGIA_BREAKER_UMBRAL_FALLOS=3
VIGIA_BREAKER_ENFRIAMIENTO_S=30

VIGIA_NAVEGADOR_HEADLESS=true
# VIGIA_NAVEGADOR_BINARIO=/usr/bin/chromium
# VIGIA_CHROMEDRIVER=/usr/bin/chromedriver

VIGIA_LOG_FORMATO=consola
VIGIA_LOG_NIVEL=INFO
